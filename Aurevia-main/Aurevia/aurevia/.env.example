# Copy to .env for local development. Leave optional integrations blank unless configured.
# Never use production credentials or a production database for local development.

# 1. Database
DATABASE_URL=
DIRECT_URL=

# 2. Authentication
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# 3. Administrator access
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 4. Email delivery
# Brevo is the supported transactional email provider. SMTP is a supported transport fallback.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VERIFICATION_EMAIL_FROM=

# 5. SMS delivery
# Termii is used for phone verification and withdrawal approval messages.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=

# 6. Phone verification and optional account-contact integration
VERIFICATION_CODE_SECRET=
AKEDLY_ENABLED=
AKEDLY_SETTINGS_PHONE_ENABLED=
AKEDLY_API_KEY=
AKEDLY_PIPELINE_ID=
AKEDLY_WIDGET_ID=
AKEDLY_PUBLIC_KEY=
AKEDLY_WIDGET_SECRET=
AKEDLY_WEBHOOK_SECRET=

# 7. Identity verification (first-party manual review)
AUREVIA_KYC_ENABLED=
AUREVIA_KYC_ENGINE=
KYC_ENCRYPTION_KEY=
KYC_MAX_DOCUMENT_SIZE_MB=
KYC_SUPABASE_URL=
KYC_SUPABASE_SERVICE_ROLE_KEY=

# 8. Market data
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
MARKET_DATA_DISPLAY_LICENSES_CONFIRMED=
MARKET_TICK_MS=
REAL_EXECUTION_ENABLED=

# 9. News
GNEWS_API_KEY=
AUREVIA_GNEWS_ALLOW_PRODUCTION=

# 10. TV and livestream content
# Broadcast/video links and publication settings are managed in the administrator content pages.
# No separate TV or livestream provider credential is currently consumed by the application.

# 11. Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 12. Notifications and scheduled workers
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
PUSH_DELIVERY_WORKER_URL=
PUSH_DELIVERY_CRON_SECRET=
CRON_SECRET=

# 13. Security and encrypted server-side settings
TOTP_ENCRYPTION_KEY=
WITHDRAWAL_DESTINATION_ENCRYPTION_KEY=
AI_SECRETS_ENCRYPTION_KEY=

# 14. Application URLs and runtime
NEXT_PUBLIC_APP_URL=
ALLOWED_APP_ORIGINS=
SUPPORT_EMAIL=
COMPLAINTS_EMAIL=
SUPPORT_PHONE=
PORT=
NODE_ENV=
RENDER_EXTERNAL_URL=
AUREVIA_CUSTOM_DOMAIN_VERIFIED=

# Optional AI providers. Allowlist only models approved for the selected provider.
AI_PROVIDER=
AI_MODEL=
AI_BACKUP_PROVIDERS=
AI_FREE_MODEL_ALLOWLIST=
OPENAI_MODEL_ALLOWLIST=
GEMINI_FREE_MODEL=
GROQ_FREE_MODEL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional DEMO-only AI recommendations; automatic DEMO execution remains opt-in.
DEMO_AI_ENABLED=
DEMO_AI_AUTO_ENABLED=
DEMO_AI_STRATEGIES=
DEMO_AI_SUPPORTED_SYMBOLS=
DEMO_AI_RISK_PER_TRADE=
DEMO_AI_MAX_POSITION_USD=
DEMO_AI_ENTRY_THRESHOLD=
DEMO_AI_STOP_LOSS_PERCENT=
DEMO_AI_TAKE_PROFIT_PERCENT=
DEMO_AI_FEE_RATE=
DEMO_AI_SPREAD_BPS=
DEMO_AI_SLIPPAGE_BPS=
DEMO_AI_EVALUATION_INTERVAL_SECONDS=

# Payment-provider credentials are parsed for compatibility only. External payment processing
# is not enabled by the application; do not add credentials expecting bank/payment settlement.
PAYMENT_PROVIDER=
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
